{
  "name": "images-api",
  "version": "0.0.1",
  "description": "Images application API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist && rimraf build",
    "build": "pnpm typecheck && pnpm clean && glob -c \"esbuild --platform=node --target=node24 --outbase=src --format=esm --outdir=dist\" \"./src/**/*.ts\" -i \"**/*.test.ts\"",
    "dev": "cross-env NODE_ENV=development tsx watch --include \"src/**/*.ts\" src/index.ts",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "test": "glob -c \"cross-env NODE_ENV=test FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --import tsx --no-warnings --test\" \"./src/**/*.test.ts\"",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "fastify",
    "server",
    "api"
  ],
  "author": {
    "email": "info@andreafrittella.com",
    "name": "Andrea Frittella"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "license": "MIT",
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/under-pressure": "^9.1.0",
    "close-with-grace": "^2.5.0",
    "cross-env": "^10.1.0",
    "env-schema": "^7.0.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "pino": "^10.3.1",
    "typebox": "^1.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.1",
    "fastify-tsconfig": "^3.0.0",
    "glob-bin": "^1.1.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
